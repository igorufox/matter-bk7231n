import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("${build_root}/toolchain/gcc_toolchain.gni")

declare_args() {
  # "wingcc": the Windows arm-none-eabi GCC 10.3.1 of PlatformIO, called from WSL through tools/wingcc.sh
  #           (tools/build.sh)
  # "native": the Linux build of the same PlatformIO package in //third_party/pio (tools/ci_build.sh)
  bk_toolchain = "wingcc"
}

if (bk_toolchain == "native") {
  _gcc = rebase_path(
          "//third_party/pio/packages/toolchain-gccarmnoneeabi/bin/arm-none-eabi-")
  _ar = "${_gcc}ar"
  _cc = "${_gcc}gcc"
  _cxx = "${_gcc}g++"
} else {
  _wrap = rebase_path("//../tools/wingcc.sh")
  _ar = "${_wrap} ar"
  _cc = "${_wrap} gcc"
  _cxx = "${_wrap} g++"
}

# ESP32: the xtensa-esp-elf GCC of the ESP-IDF of Arduino-ESP32 (crosstool-NG esp-14.2.0_20260121, the
# toolchain-xtensa-esp-elf of pioarduino), its xtensa-esp32-elf-* commands; //third_party/esp32-toolchain is a link
# made by tools/ci_build.sh
_esp32 = rebase_path("//third_party/esp32-toolchain/bin/xtensa-esp32-elf-")

gcc_toolchain("esp32") {
  ar = "${_esp32}ar"
  cc = "${_esp32}gcc"
  cxx = "${_esp32}g++"

  toolchain_args = {
    current_os = "freertos"
    current_cpu = "esp32"
    is_clang = false
  }
}

gcc_toolchain("bk7231n") {
  ar = _ar
  cc = _cc
  cxx = _cxx

  toolchain_args = {
    current_os = "freertos"
    current_cpu = "arm"
    is_clang = false
  }
}
