import("//build_overrides/chip.gni")
import("${chip_root}/src/platform/device.gni")


static_library("MatterApp") {
  sources = [
    "AppServer.cpp",
    "CHIPDeviceManager.cpp",
    "CommonDeviceCallbacks.cpp",
    "OTAHelper.cpp",
    "matter_app.cpp",
  ]
  public_deps = [
    "${chip_root}/examples/espurna-plug:plug-data-model",
    "${chip_root}/src/app/clusters/basic-information",
    "${chip_root}/src/app/persistence",
    "${chip_root}/src/app/persistence:singleton",
    "${chip_root}/src/lib",
    "${chip_root}/src/setup_payload",
  ]
  # the chip's port of the BK7231N (__atomic_*, the bk_* API ESPurna implements); the ESP32 platform is
  # connectedhomeip's own (src/platform/ESP32, through chip_device_platform)
  if (chip_device_platform == "external") {
    public_deps += [ "//external_platform/BK7231N:bk7231n_port" ]
  }
  output_name = "libMatterApp"
  output_dir = "${root_out_dir}/lib"
  complete_static_lib = true
}
