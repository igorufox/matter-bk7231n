# Data model of the plug: Root node + On/Off Plug-in Unit 0x010A (chef rootnode_onoffpluginunit_Wtf8ss5EBY).
# tools/build.sh copies this file to <connectedhomeip>/examples/bk7231n-plug/BUILD.gn: since connectedhomeip 1.5 a
# chip_data_model target may depend on src/app:required-privileges only from //third_party/connectedhomeip/examples/*
import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("${chip_root}/src/app/chip_data_model.gni")

chip_data_model("plug-data-model") {
  zap_file = "//app/plug.zap"
  idl = "//app/plug.matter"
  is_server = true
}
